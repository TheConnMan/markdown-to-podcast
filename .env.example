# Application Configuration
NODE_ENV=development
PORT=3000
API_KEY=your-secret-api-key-here
PODCAST_UUID=abcd1234-5678-90ef-ghij-klmnop123456

# ElevenLabs TTS Configuration
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Storage Configuration
AUDIO_OUTPUT_DIR=/app/data/audio
METADATA_FILE=/app/data/episodes.json
MAX_EPISODES=25

# RSS Feed Configuration
BASE_URL=https://your-domain.com
PODCAST_TITLE=My Markdown Podcast
PODCAST_DESCRIPTION=Personal podcast feed for markdown content
PODCAST_AUTHOR=Your Name
PODCAST_EMAIL=your.email@example.com
PODCAST_LANGUAGE=en

# Production Configuration (for docker-compose.yml)
DOMAIN=your-domain.com
ACME_EMAIL=your.email@example.com